{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Participant",
  "description": "Schema for a meeting participant.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique identifier for a participant."
    },
    "nombre": {
      "type": "string"
    },
    "rol": {
      "type": "string",
      "enum": ["Owner", "Facilitator", "Scribe", "Approver", "Guest"],
      "description": "The role of the participant in the meeting."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The participant's optional email address."
    }
  },
  "required": ["nombre", "rol"]
}
