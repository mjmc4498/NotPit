{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Timeline Event",
  "description": "Schema for an event that occurs during a meeting's lifecycle.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "meetingId": {
      "type": "integer",
      "description": "The ID of the meeting this event belongs to."
    },
    "timestamp": {
        "type": "string",
        "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "The type of event (e.g., 'MEETING_CREATED', 'TASK_STATUS_CHANGED')."
    },
    "details": {
        "type": "object",
        "description": "An object containing event-specific details."
    }
  },
  "required": ["meetingId", "timestamp", "type", "details"]
}
